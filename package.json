{
  "name": "r-qol",
  "displayName": "R-QoL",
  "version": "0.0.0",
  "publisher": "rommmmaha",
  "description": "Quality of life: bookmarked project paths as a sidebar tree.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "bookmarks",
    "projects",
    "sidebar",
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "VoidFrame",
        "uiTheme": "vs-dark",
        "path": "./colors.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "r-qol",
          "title": "Bookmarks",
          "icon": "./icon.svg"
        }
      ]
    },
    "views": {
      "r-qol": [
        {
          "id": "r-qolBookmarks",
          "name": "Bookmarks"
        }
      ]
    },
    "commands": [
      {
        "command": "r-qol.refresh",
        "title": "R-QoL: Bookmarks refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "r-qol.addBookmark",
        "title": "R-QoL: Bookmark add",
        "icon": "$(bookmark)"
      },
      {
        "command": "r-qol.removeBookmark",
        "title": "R-QoL: Bookmark remove",
        "icon": "$(bookmark-remove)"
      },
      {
        "command": "r-qol.openWorkspace",
        "title": "R-QoL: Open bookmark"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "r-qol.addBookmark"
        },
        {
          "command": "r-qol.removeBookmark"
        }
      ],
      "view/title": [
        {
          "command": "r-qol.refresh",
          "when": "view == r-qolBookmarks"
        },
        {
          "command": "r-qol.addBookmark",
          "when": "view == r-qolBookmarks"
        },
        {
          "command": "r-qol.removeBookmark",
          "when": "view == r-qolBookmarks"
        }
      ]
    },
    "configuration": {
      "title": "R-QoL",
      "properties": {
        "r-qol.bookmarks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "List of project paths to bookmark. Supports ~ and $HOME for home directory. Append /* to include all level 1 subdirectories."
        }
      }
    }
  },
  "icon": "./icon.png",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^3.9.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
