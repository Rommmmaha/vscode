  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#666666"
      }
    },
    {
      "name": "Punctuation & Operators",
      "scope": ["punctuation", "keyword.operator", "meta.brace"],
      "settings": {
        "foreground": "#999999"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "storage.type",
        "control.elements"
      ],
      "settings": {
        "foreground": "#85cef2"
      }
    },
    {
      "name": "Functions & Variables",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable",
        "variable.other",
        "variable.language",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#85cef2"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#f2bc85"
      }
    },
    {
      "name": "Numbers, Booleans & Constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#ce85f2"
      }
    },
    {
      "name": "Object Keys, Properties & Tags",
      "scope": [
        "meta.object-literal.key",
        "entity.name.tag",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#999999"
      }
    }
  ]
}
