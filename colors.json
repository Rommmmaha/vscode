  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "name": "Punctuation & Operators",
      "scope": ["punctuation", "keyword.operator", "meta.brace"],
      "settings": {
        "foreground": "#aaaaaa"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "storage.type",
        "control.elements"
      ],
      "settings": {
        "foreground": "#6bb3fb"
      }
    },
    {
      "name": "Functions & Variables",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable",
        "variable.other",
        "variable.language",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#6bb3fb"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#e89954"
      }
    },
    {
      "name": "Numbers, Booleans & Constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#c796ea"
      }
    },
    {
      "name": "Object Keys, Properties & Tags",
      "scope": [
        "meta.object-literal.key",
        "entity.name.tag",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#aaaaaa"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {
        "foreground": "#f48c85"
      }
    }
  ]
}
